{
  "name": "@cluetec/ngcx-tree",
  "version": "22.0.0",
  "scripts": {
    "ng": "ng",
    "build:css": "sass projects/ngcx-tree/styles/styles.scss dist/ngcx-tree/styles/styles.css",
    "start": "ng serve",
    "build": "ng build",
    "build-prod:lib": "npm run build:css & ng-packagr -p projects/ngcx-tree/ng-package.json -c projects/ngcx-tree/tsconfig.lib.prod.json",
    "publish:lib": "npm run copy:readme && npm run copy:changelog && npm run copy:license && npm publish ./dist/ngcx-tree --tag next",
    "prepare-publish:lib": "npm run copy:readme && npm run copy:changelog && npm run copy:license",
    "copy:readme": "cpx README.md dist/ngcx-tree",
    "copy:changelog": "cpx CHANGELOG.md dist/ngcx-tree",
    "copy:license": "cpx LICENSE dist/ngcx-tree",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "provide:link": "cd dist/ngcx-tree && npm link",
    "storybook": "ng run ngcx-tree:storybook",
    "build-storybook": "ng run ngcx-tree:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "rxjs": "~7.8.2",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.2.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@chromatic-com/storybook": "^5.3.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/angular": "^10.6.0",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "cpx2": "^9.0.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.0",
    "angular-eslint": "^22.1.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "^17.0.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "storybook": "^10.5.10",
    "tslib": "^2.6.2",
    "typescript-eslint": "^8.70.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "angular",
    "component",
    "tree",
    "dnd",
    "d&d",
    "drag&drop",
    "drag and drop"
  ]
}
